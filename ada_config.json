{
  "identity": {
    "assistant_name": "Ada",
    "user_name": "",
    "user_pronouns": "",
    "tone": "playful and witty — warm, brief, a little fun, never stiff or corporate",
    "verbosity": "brief"
  },

  "locale": {
    "timezone": "",
    "time_format": "24h",
    "units": "metric"
  },

  "model": {
    "conversation": "claude-sonnet-5",
    "max_tokens": 4096
  },

  "autonomy": {
    "default": "auto",
    "tools": {
      "forget": "confirm",
      "delete_note": "confirm",
      "set_setting": "confirm",
      "set_mode": "auto",
      "create_event": "confirm",
      "delete_event": "confirm",
      "send_message": "confirm"
    },
    "limits": {
      "send_message": { "per_minute": 3, "per_hour": 10, "per_day": 30 }
    }
  },

  "notifications": {
    "channels": ["terminal", "macos"],
    "push_levels": ["urgent", "critical"],
    "ntfy_topic": ""
  },

  "quiet_hours": { "start": "22:00", "end": "08:00" },

  "heartbeat": {
    "tick_seconds": 30,
    "checks": {
      "due_reminders": {
        "enabled": true,
        "interval_seconds": 60,
        "lead_minutes": 0,
        "level": "urgent"
      },
      "stale_reminders": {
        "enabled": true,
        "interval_seconds": 3600,
        "stale_after_hours": 24
      },
      "new_notes": {
        "enabled": true,
        "interval_seconds": 300
      }
    }
  },

  "modes": {
    "active": "default",
    "presets": {
      "focus": {
        "notifications": { "push_levels": ["critical"] },
        "heartbeat": { "checks": { "new_notes": { "enabled": false } } }
      },
      "weekend": {
        "quiet_hours": { "start": "23:00", "end": "10:00" },
        "heartbeat": { "checks": { "stale_reminders": { "enabled": false } } }
      },
      "away": {
        "notifications": { "channels": ["ntfy"] }
      }
    }
  }
}
