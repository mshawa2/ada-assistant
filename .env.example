ANTHROPIC_API_KEY=

# Voice mode only (Tier 3)
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=yj30vwTGJxSHezdAGsv9

# Web search. Without one of these, web_search falls back to Wikipedia only —
# it still works, it just can't search the open web. Both have free tiers.
# DuckDuckGo's keyless endpoints were tested and return nothing, so there is no
# no-key option for real search.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Phone push. A topic name is effectively a password — anyone who knows it can
# read your notices — so set it here rather than in ada_config.json, which is
# tracked in git. Pick something unguessable.
ADA_NTFY_TOPIC=

# Optional: relocate Ada's data / settings (handy for a second instance).
# ADA_DATA_DIR=
# ADA_CONFIG_FILE=
