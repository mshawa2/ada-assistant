ANTHROPIC_API_KEY=

# Voice mode only (Tier 3)
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=yj30vwTGJxSHezdAGsv9

# Web search. Without one of these, web_search falls back to Wikipedia only —
# it still works, it just can't search the open web. Both have free tiers.
# DuckDuckGo's keyless endpoints were tested and return nothing, so there is no
# no-key option for real search.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Email (read-only). For Gmail this must be an App Password from
# https://myaccount.google.com/apppasswords — not your account password.
# Your address and server go in ada_config.json under "email".
IMAP_PASSWORD=

# Smart home, optional. With these, Ada can control devices directly.
# Without them she falls back to running Apple Shortcuts you've made (which is
# how you reach HomeKit from a Mac). Token = a long-lived access token.
HASS_URL=
HASS_TOKEN=

# Purchasing, optional and off by default. A vendor is an endpoint YOU control
# (a webhook, a Home Assistant script, an n8n flow) — Ada can never choose a
# destination herself. Define it in ada_config.json under purchasing.vendors,
# put its token here as ADA_VENDOR_TOKEN_<NAME>, and raise
# budget.limits.purchases above 0.00. All three are needed before anything
# can be spent.
# ADA_VENDOR_TOKEN_GROCERIES=

# Phone push. A topic name is effectively a password — anyone who knows it can
# read your notices — so set it here rather than in ada_config.json, which is
# tracked in git. Pick something unguessable.
ADA_NTFY_TOPIC=

# Optional: relocate Ada's data / settings (handy for a second instance).
# ADA_DATA_DIR=
# ADA_CONFIG_FILE=
